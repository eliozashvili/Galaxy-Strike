  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogues
  dialogueText:
  - 'Liutenant: Crikey!  Looks like you could use a hand.'
  - 'Commander: It''s a trap!  Get out of there.'
  - 'Liutenant: Righteo let''s finish this once and for all.'
  - 'Commander: Like shooting fish in a barrel!'
  - 'Liutenant: Struth!  Looks like the galaxy just got a little more safe.'
  - 'Commander: Never thought I''d see your face around here general...'
  - 'Commander: We''re glad to have you here Lieutenant.  We could really use your
    help!'
  - 'Commander: Yeeeehaw!!  You did it!'
  dialogueTextField: {fileID: 1588629947}
